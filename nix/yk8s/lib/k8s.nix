{lib}: {
  mkTolerations = {scheduling_key ? null}:
    lib.optionals (scheduling_key != null) [
      {
        "key" = scheduling_key;
        "operator" = "Exists";
        "effect" = "NoSchedule";
      }
      {
        "key" = scheduling_key;
        "operator" = "Exists";
        "effect" = "NoExecute";
      }
    ];

  mkAffinity = {
    scheduling_key ? null,
    pod_affinity_key ? null,
    pod_affinity_operator ? "Exists",
    pod_affinity_values ? [],
  }:
    (lib.optionalAttrs (scheduling_key != null) {
      "nodeAffinity" = {
        "requiredDuringSchedulingIgnoredDuringExecution" = {
          "nodeSelectorTerms" = [
            {
              "matchExpressions" = [
                {
                  "key" = scheduling_key;
                  "operator" = "Exists";
                }
              ];
            }
          ];
        };
      };
    })
    // (lib.optionalAttrs (pod_affinity_key != null) {
      "podAffinity" = {
        "requiredDuringSchedulingIgnoredDuringExecution" = [
          {
            "labelSelector" = {
              "matchExpressions" = [
                {
                  "key" = pod_affinity_key;
                  "operator" = pod_affinity_operator;
                  "values" = pod_affinity_values;
                }
              ];
            };
            "topologyKey" = "kubernetes.io/hostname";
          }
        ];
      };
    });

  /*
  Merges `extra` into the configuration `base` generated by Tarook.
  Attribute sets are merged recursively and the values of `extra` take precedence.
  Lists are appended, except for lists of attribute sets with a `name`,
  e.g. `extraArgs` of kubeadm: their entries in `extra` replace the entries
  with the same name in `base`, because kubeadm passes duplicate arguments on.
  */
  mergeExtraConfig = let
    isNamedList = lib.all (e: lib.isAttrs e && e ? name);
    merge = base: extra:
      if lib.isAttrs base && lib.isAttrs extra
      then base // lib.mapAttrs (n: v: if base ? ${n} then merge base.${n} v else v) extra
      else if lib.isList base && lib.isList extra
      then
        if isNamedList base && isNamedList extra
        then let
          names = map (e: e.name) extra;
        in
          lib.filter (e: !(builtins.elem e.name names)) base ++ extra
        else base ++ extra
      else extra;
  in
    merge;

  /*
  Assertions that fields are not set in `option`.
  `fields` is a list of `{ field, isSet, reason }`.
  */
  mkFieldsNotSetAssertions = option:
    map ({
      field,
      isSet,
      reason,
    }: {
      assertion = !isSet;
      message = "${option}.${field}: must not be set, ${reason}.";
    });
}
