{
  config,
  lib,
  yk8s-lib,
  ...
}: let
  cfg = config.yk8s.kubernetes;
  inherit (yk8s-lib) mkInternalOption types;

  inherit (config.yk8s.infra) ipv4_enabled ipv6_enabled;
in {
  options.yk8s.kubernetes.kubeadm = {
    # The configurations generated by Tarook for each node, merged with the extra configurations
    initConfigurations = mkInternalOption {
      type = with types; attrsOf yk8s.formats.jsonValue;
      readOnly = true;
      apply = lib.mapAttrs (_: generated: yk8s-lib.k8s.mergeExtraConfig generated cfg.kubeadm.extraInitConfiguration);
    };
    joinConfigurations = mkInternalOption {
      type = with types; attrsOf yk8s.formats.jsonValue;
      readOnly = true;
      apply = lib.mapAttrs (_: generated: yk8s-lib.k8s.mergeExtraConfig generated cfg.kubeadm.extraJoinConfiguration);
    };
    extraInitConfiguration = lib.mkOption {
      description = ''
        Extra settings for the kubeadm ``InitConfiguration`` of the control plane nodes, see the
        `kubeadm Configuration (v1beta4) <https://kubernetes.io/docs/reference/config-api/kubeadm-config.v1beta4/>`_.
        It is only used when the cluster is created.

        The settings are merged into the configuration that Tarook generates for each node
        and take precedence.
        Lists are appended, except for lists of entries with a ``name``, e.g. ``kubeletExtraArgs``,
        whose entries replace the generated entries with the same name.
        Node-specific fields, e.g. ``nodeRegistration.name``, cannot be set here.

        To see the rendered configurations, look at the files referenced by
        ``k8s_kubeadm_initConfigurationBundles`` in
        ``inventory/yaook-k8s/group_vars/all/kubernetes.yaml``
        (updated by :ref:`update-inventory.sh <actions-references.update-inventorysh>`).
      '';
      type = with types; attrsOf yk8s.formats.jsonValue;
      default = {};
      example = {
        timeouts.controlPlaneComponentHealthCheck = "8m0s";
      };
    };
    extraJoinConfiguration = lib.mkOption {
      description = ''
        Extra settings for the kubeadm ``JoinConfiguration`` of all nodes, see the
        `kubeadm Configuration (v1beta4) <https://kubernetes.io/docs/reference/config-api/kubeadm-config.v1beta4/>`_.
        It is only used when a node joins the cluster.

        The settings are merged into the configuration that Tarook generates for each node
        and take precedence.
        Lists are appended, except for lists of entries with a ``name``, e.g. ``kubeletExtraArgs``,
        whose entries replace the generated entries with the same name.
        Node-specific fields, e.g. ``nodeRegistration.name``, cannot be set here.

        To see the rendered configurations, look at the files referenced by
        ``k8s_kubeadm_joinConfigurationFiles`` in
        ``inventory/yaook-k8s/group_vars/all/kubernetes.yaml``
        (updated by :ref:`update-inventory.sh <actions-references.update-inventorysh>`).
      '';
      type = with types; attrsOf yk8s.formats.jsonValue;
      default = {};
      example = {
        timeouts.tlsBootstrap = "10m0s";
      };
    };
    joinConfigurationFiles = mkInternalOption {
      type = with types; attrsOf pathInStore;
      readOnly = true;
    };
    initConfigurationBundles = mkInternalOption {
      type = with types; attrsOf pathInStore;
      readOnly = true;
    };
  };
  config.yk8s.kubernetes.kubeadm = let
    mkNodeRegistration = hostName: hostValues: {
      name = hostName;
      kubeletExtraArgs =
        [
          {
            name = "node-ip";
            value = lib.concatStringsSep "," (
              (lib.optional ipv4_enabled hostValues.local_ipv4_address)
              ++ (lib.optional ipv6_enabled hostValues.local_ipv6_address)
            );
          }
        ]
        ++ lib.optional config.yk8s.openstack.enabled {
          name = "cloud-provider";
          value = "external";
        };
    };
    mkLocalAPIEndpoint = hostValues: {
      advertiseAddress =
        if ipv4_enabled
        then hostValues.local_ipv4_address
        else hostValues.local_ipv6_address;
      bindPort = 6443;
    };
    mkInitConfiguration = hostName: hostValues: {
      apiVersion = "kubeadm.k8s.io/v1beta4";
      kind = "InitConfiguration";
      nodeRegistration = mkNodeRegistration hostName hostValues;
      localAPIEndpoint = mkLocalAPIEndpoint hostValues;
      patches.directory = cfg.kubeadm.patches_remote_dir;
    };
    mkJoinConfiguration = hostName: hostValues:
      {
        apiVersion = "kubeadm.k8s.io/v1beta4";
        kind = "JoinConfiguration";
        nodeRegistration =
          (mkNodeRegistration hostName hostValues)
          // {
            ignorePreflightErrors =
              [
                "FileAvailable--etc-kubernetes-kubelet.conf"
              ]
              ++ (lib.optional (hostValues.role == "worker")
                "FileAvailable--etc-kubernetes-pki-ca.crt");
          };
        discovery.file.kubeConfigPath = "/etc/kubernetes/kubelet.conf";
        # v1beta4 moved discovery.timeout to timeouts.discovery
        timeouts.discovery = "5m0s";
        patches.directory = cfg.kubeadm.patches_remote_dir;
      }
      // lib.optionalAttrs (hostValues.role == "master") {
        controlPlane.localAPIEndpoint = mkLocalAPIEndpoint hostValues;
      };
  in {
    initConfigurations = lib.mapAttrs mkInitConfiguration config.yk8s.infra.final_hosts.masters.hosts;
    joinConfigurations = lib.mapAttrs mkJoinConfiguration config.yk8s.infra.final_hosts.k8s_nodes.hosts;

    initConfigurationBundles =
      lib.mapAttrs (
        hostName: initConfiguration:
          yk8s-lib.mkYamlBundle "${hostName}-initConfigurationBundle.yaml" ([
              initConfiguration
              cfg.kubeadm.clusterConfiguration
              ({
                  apiVersion = "kubelet.config.k8s.io/v1beta1";
                  kind = "KubeletConfiguration";
                }
                // cfg.kubelet.kubeletConfiguration)
            ]
            ++ lib.optional cfg.network.kube_proxy.enabled cfg.network.kube_proxy.kubeProxyConfiguration)
      )
      cfg.kubeadm.initConfigurations;

    joinConfigurationFiles = lib.mapAttrs (hostName: yk8s-lib.mkYaml "${hostName}-joinConfiguration.yaml") cfg.kubeadm.joinConfigurations;
  };
  config.yk8s._targets.ansible.assertions = let
    nodeSpecific = "it is set by Tarook for each node";
    setsNodeIp = extra: lib.any (arg: arg.name or null == "node-ip") (extra.nodeRegistration.kubeletExtraArgs or []);
    common = extra: [
      {
        field = "nodeRegistration.name";
        isSet = extra ? nodeRegistration.name;
        reason = nodeSpecific;
      }
      {
        field = "nodeRegistration.kubeletExtraArgs (node-ip)";
        isSet = setsNodeIp extra;
        reason = nodeSpecific;
      }
      {
        field = "patches";
        isSet = extra ? patches;
        reason = "use config.yk8s.kubernetes.kubeadm.patches instead";
      }
    ];
    init = cfg.kubeadm.extraInitConfiguration;
    join = cfg.kubeadm.extraJoinConfiguration;
  in
    yk8s-lib.k8s.mkFieldsNotSetAssertions "config.yk8s.kubernetes.kubeadm.extraInitConfiguration" (common init
      ++ [
        {
          field = "localAPIEndpoint";
          isSet = init ? localAPIEndpoint;
          reason = nodeSpecific;
        }
      ])
    ++ yk8s-lib.k8s.mkFieldsNotSetAssertions "config.yk8s.kubernetes.kubeadm.extraJoinConfiguration" (common join
      ++ [
        {
          field = "controlPlane";
          isSet = join ? controlPlane;
          reason = "it is set by Tarook for each control plane node";
        }
        {
          field = "discovery";
          isSet = join ? discovery;
          reason = "it is set by Tarook";
        }
      ]);
}
