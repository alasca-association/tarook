{
  config,
  lib,
  yk8s-lib,
  ...
}: let
  cfg = config.yk8s.kubernetes;
  inherit (yk8s-lib) types;
in {
  options.yk8s.kubernetes.kubeadm = {
    # The ClusterConfiguration generated by Tarook, merged with extraClusterConfiguration
    clusterConfiguration = yk8s-lib.mkInternalOption {
      type = types.yk8s.formats.jsonValue;
      readOnly = true;
      apply = generated: yk8s-lib.k8s.mergeExtraConfig generated cfg.kubeadm.extraClusterConfiguration;
    };
    extraClusterConfiguration = lib.mkOption {
      description = ''
        Extra settings for the kubeadm ``ClusterConfiguration``, see the
        `kubeadm Configuration (v1beta4) <https://kubernetes.io/docs/reference/config-api/kubeadm-config.v1beta4/>`_.

        They are merged into the configuration that Tarook generates and take precedence.
        Lists are appended, except for lists of entries with a ``name``, e.g. ``extraArgs``,
        whose entries replace the generated entries with the same name.
        Fields that are set from other options, e.g. ``kubernetesVersion``, cannot be set here.

        Changes are applied to existing clusters, except for the etcd settings,
        which are applied on the next Kubernetes upgrade.
      '';
      type = types.attrsOf types.yk8s.formats.jsonValue;
      default = {};
      example = {
        apiServer.extraArgs = [
          {
            name = "profiling";
            value = "false";
          }
        ];
      };
    };
  };
  config.yk8s.kubernetes.kubeadm.clusterConfiguration = let
    inherit
      (config.yk8s.infra)
      ipv4_enabled
      ipv6_enabled
      networking_fixed_ip
      networking_fixed_ip_v6
      ;
  in {
    apiVersion = "kubeadm.k8s.io/v1beta4";
    kind = "ClusterConfiguration";
    kubernetesVersion = "v${cfg.version}";
    controlPlaneEndpoint = "${
      if ipv4_enabled
      then networking_fixed_ip
      else "[${networking_fixed_ip_v6}]"
    }:${toString cfg.apiserver.frontend_port}";
    networking = {
      podSubnet = lib.concatStringsSep "," (
        (lib.optional ipv4_enabled cfg.network.pod_subnet)
        ++ (lib.optional ipv6_enabled cfg.network.pod_subnet_v6)
      );
      serviceSubnet = lib.concatStringsSep "," (
        (lib.optional ipv4_enabled cfg.network.service_subnet)
        ++ (lib.optional ipv6_enabled cfg.network.service_subnet_v6)
      );
    };
    proxy.disabled = !cfg.network.kube_proxy.enabled;
    apiServer = let
      auditPolicyPath = "/etc/kubernetes/audit-policy.yaml";
      auditLogsDir = "/var/log/kubernetes/audit/";
    in {
      extraArgs =
        [
          {
            name = "service-account-issuer";
            value = "https://kubernetes.default.svc";
          }
          {
            name = "service-account-signing-key-file";
            value = "/etc/kubernetes/pki/sa.key";
          }
          {
            name = "enable-admission-plugins";
            value = "NodeRestriction";
          }
        ]
        ++ lib.optionals cfg.apiserver.audit_logs.enabled [
          {
            name = "audit-policy-file";
            value = auditPolicyPath;
          }
          {
            name = "audit-log-path";
            value = "${auditLogsDir}audit.log";
          }
          {
            name = "audit-log-maxage";
            value = "1";
          }
          {
            name = "audit-log-maxsize";
            value = toString cfg.apiserver.audit_logs.max_size;
          }
          {
            name = "audit-log-maxbackup";
            value = "1";
          }
        ];
      extraVolumes = lib.optionals cfg.apiserver.audit_logs.enabled [
        {
          name = "audit-policy";
          hostPath = auditPolicyPath;
          mountPath = auditPolicyPath;
          readOnly = true;
          pathType = "File";
        }
        {
          name = "audit-log";
          hostPath = auditLogsDir;
          mountPath = auditLogsDir;
          pathType = "DirectoryOrCreate";
        }
      ];
    };
    etcd.local.extraArgs = lib.optional (ipv4_enabled && ipv6_enabled) {
      name = "listen-metrics-urls";
      value = "http://127.0.0.1:2381,http://[::1]:2381";
    };
    controllerManager.extraArgs =
      [
        {
          name = "bind-address";
          value =
            if ipv4_enabled
            then "0.0.0.0"
            else "::";
        }
        {
          name = "large-cluster-size-threshold";
          value = toString cfg.controller_manager.large_cluster_size_threshold;
        }
      ]
      ++ lib.optional ipv6_enabled {
        # The size for the pod subnets of the nodes.
        # This value is not respected by calico.
        # The maximum allowed diff is 16 bits and the smallest allowed value is /112
        name = "node-cidr-mask-size-ipv6";
        value = let
          podSubnetPrefixLength = lib.toInt (lib.last (lib.splitString "/" cfg.network.pod_subnet_v6));
        in
          toString (lib.min (podSubnetPrefixLength + 16) 112);
      };
    scheduler.extraArgs = [
      {
        name = "bind-address";
        value =
          if ipv4_enabled
          then "0.0.0.0"
          else "::";
      }
    ];
  };
  config.yk8s._targets.ansible.assertions = let
    extra = cfg.kubeadm.extraClusterConfiguration;
  in
    yk8s-lib.k8s.mkFieldsNotSetAssertions "config.yk8s.kubernetes.kubeadm.extraClusterConfiguration" [
      {
        field = "kubernetesVersion";
        isSet = extra ? kubernetesVersion;
        reason = "use config.yk8s.kubernetes.version instead";
      }
      {
        field = "controlPlaneEndpoint";
        isSet = extra ? controlPlaneEndpoint;
        reason = "it is set from config.yk8s.infra.networking_fixed_ip and config.yk8s.kubernetes.apiserver.frontend_port";
      }
      {
        field = "networking.podSubnet";
        isSet = extra ? networking.podSubnet;
        reason = "use config.yk8s.kubernetes.network.pod_subnet and pod_subnet_v6 instead";
      }
      {
        field = "networking.serviceSubnet";
        isSet = extra ? networking.serviceSubnet;
        reason = "use config.yk8s.kubernetes.network.service_subnet and service_subnet_v6 instead";
      }
      {
        field = "proxy.disabled";
        isSet = extra ? proxy.disabled;
        reason = "use config.yk8s.kubernetes.network.kube_proxy.enabled instead";
      }
    ];
}
