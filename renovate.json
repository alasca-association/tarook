{
  "enabledManagers": [
    "nix",
    "dockerfile",
    "gitlabci",
    "regex",
    "terraform",
    "ansible",
    "ansible-galaxy"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "ansible-galaxy": {
    "fileMatch": [
      "^ansible/requirements.yaml$"
    ]
  },
  "postUpgradeTasks": {
    "commands": ["bash ci/scripts/create_renovate_release_note.sh '{{{datasource}}}' '{{{depNameSanitized}}}' '{{{sourceUrl}}}' '{{{currentVersion}}}' '{{{newVersion}}}' '{{{isMajor}}}'"],
    "executionMode": "branch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^nix/yk8s/.*\\.nix$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) registryUrl=(?<registryUrl>.*?)\\n\\s*default\\s=\\s\"(?<currentValue>.*?)\";\\n"
      ],
      "datasourceTemplate": "helm",
      "versioningTemplate": "semver"
    }
  ]
}
