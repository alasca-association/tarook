{{ _auto_generated_preamble }}

apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  kubeletExtraArgs:
{% if openstack_enabled %}
    - name: cloud-provider
      value: "external"
{% endif %}
{% if ipv4_enabled and ipv6_enabled %}
    - name: node-ip
      value: {{ [local_ipv4_address, local_ipv6_address] | join(",") | to_json }}
{% elif ipv4_enabled %}
    - name: node-ip
      value: {{ local_ipv4_address | to_json }}
{% elif ipv6_enabled %}
    - name: node-ip
      value: {{ local_ipv6_address | to_json }}
{% endif %}
  name: {{ inventory_hostname }}

localAPIEndpoint:
{% if ipv4_enabled %}
  advertiseAddress: {{ local_ipv4_address | to_json }}
{% elif ipv6_enabled %}
  advertiseAddress: {{ local_ipv6_address | to_json }}
{% endif %}
  bindPort: 6443

---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "v{{ k8s_version }}"
controlPlaneEndpoint: "{% if ipv4_enabled %}{{ networking_fixed_ip }}{% else %}[{{ networking_fixed_ip_v6 }}]{% endif %}:{{ k8s_apiserver_frontend_port }}"
networking:
{% if ipv4_enabled and ipv6_enabled %}
    podSubnet: {{ [k8s_network_pod_subnet, k8s_network_pod_subnet_v6] | join(",") | to_json }}
    serviceSubnet: {{ [k8s_network_service_subnet, k8s_network_service_subnet_v6] | join(",") | to_json }}
{% elif ipv4_enabled %}
    podSubnet: {{ k8s_network_pod_subnet | to_json }}
    serviceSubnet: {{ k8s_network_service_subnet | to_json }}
{% elif ipv6_enabled %}
    podSubnet: {{ k8s_network_pod_subnet_v6 | to_json }}
    serviceSubnet: {{ k8s_network_service_subnet_v6 | to_json }}
{% endif %}

apiServer:
  extraArgs:
    - name: service-account-issuer
      value: "https://kubernetes.default.svc"
    - name: service-account-signing-key-file
      value: "/etc/kubernetes/pki/sa.key"
    - name: enable-admission-plugins
      value: "NodeRestriction"

etcd:
  local:
    extraArgs:
{% if ipv4_enabled and ipv6_enabled %}
      - name: listen-metrics-urls
        value: "http://127.0.0.1:2381,http://[::1]:2381"
{% endif %}

controllerManager:
  extraArgs:
{% if ipv4_enabled %}
    - name: bind-address
      value: "0.0.0.0"
{% elif ipv6_enabled %}
    - name: bind-address
      value: "::"
{% endif %}
    - name: large-cluster-size-threshold
      value: "{{ k8s_controller_manager_large_cluster_size_threshold | default(50) }}"
{% if ipv6_enabled %}
    # The size for the pod subnets of the nodes.
    # This value is not respected by calico.
    # The maximum allowed diff is 16 bits and the smallest allowed value is /112
    - name: node-cidr-mask-size-ipv6
      value: "{{ [((k8s_network_pod_subnet_v6 | split('/'))[1] | int) + 16, 112] | min }}"
{% endif %}

scheduler:
    extraArgs:
{% if ipv4_enabled %}
      - name: bind-address
        value: "0.0.0.0"
{% elif ipv6_enabled %}
      - name: bind-address
        value: "::"
{% endif %}

---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
{% if ipv4_enabled %}
metricsBindAddress: "0.0.0.0:10249"
{% elif ipv6_enabled %}
metricsBindAddress: "[::]:10249"
{% endif %}
{% if ipv6_enabled %}
mode: ipvs
{% endif %}

---
kind: KubeletConfiguration
apiVersion: kubelet.config.k8s.io/v1beta1
cgroupDriver: systemd
featureGates:
{% if ipv4_enabled and ipv6_enabled and k8s_version is version('1.32', '<') %}
  # defaults to true with k8s >= 1.29
  # Went GA with K8s v1.32, drop this along with Kubernetes v1.31
  CloudDualStackNodeIPs: true
{% endif %}
