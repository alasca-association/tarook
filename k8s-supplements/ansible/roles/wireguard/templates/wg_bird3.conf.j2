{{ _auto_generated_preamble }}

function filter_wireguard() -> bool {
{% for ep in wg_endpoints %}
{% if ep.enabled and ep.ip_cidr is not none %}
    if net = {{ ep.ip_cidr }} then return true;
{% endif %}
{% endfor %}
    return false;
}

{% if ipv6_enabled %}
function filter_wireguard_v6() -> bool {
{% for ep in wg_endpoints %}
{% if ep.enabled and ep.ipv6_cidr is not none %}
    if net = {{ ep.ipv6_cidr }} then return true;
{% endif %}
{% endfor %}
    return false;
}
{% endif %}
