apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    nginx.ingress.kubernetes.io/backend-protocol: HTTPS
    nginx.ingress.kubernetes.io/ssl-passthrough: "true"
  labels:
    app.kubernetes.io/instance: openbao
    app.kubernetes.io/name: openbao-external
  name: openbao-external
  namespace: {{ openbao_on_k8s.namespace }}
spec:
  ingressClassName: {{ openbao_on_k8s.external_ingress_class | to_json }}
  rules:
{% for name in openbao_on_k8s.dnsnames %}
  - host: {{ name | to_json }}
    http:
      paths:
      - backend:
          service:
            name: openbao-external-active
            port:
              number: 8250
        path: /
        pathType: Prefix
{% endfor %}
  tls:
  - hosts:
{% for name in openbao_on_k8s.dnsnames %}
    - {{ name | to_json }}
{% endfor %}
    secretName: openbao-cert-external
