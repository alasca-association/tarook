apiVersion: v1
data:
  s3_access_key: {{ openbao_on_k8s_backup_s3.access_key | b64encode }}
  s3_secret_key: {{ openbao_on_k8s_backup_s3.secret_key | b64encode }}
  s3_ca.crt: {{ openbao_on_k8s_backup_s3.endpoint_cacrt | b64encode }}
  s3_endpoint: {{ openbao_on_k8s_backup_s3.endpoint_url | b64encode }}
  openbao_role_id: {{ openbao_on_k8s_backup_approle_role_id | b64encode }}
  openbao_secret_id: {{ openbao_on_k8s_backup_approle_secret_id | b64encode }}
  openbao_approle_path: {{ openbao_on_k8s_backup_approle_path | b64encode }}
kind: Secret
metadata:
  name: openbao-backup
  namespace: {{ openbao_on_k8s.namespace | to_json }}
type: Opaque

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openbao-backup
  namespace: {{ openbao_on_k8s.namespace | to_json }}
spec:
  replicas: 1
  selector:
    matchLabels:
      yaook.cloud/component: openbao-backup
  template:
    metadata:
      labels:
        yaook.cloud/component: openbao-backup
    spec:
      automountServiceAccountToken: false
      containers:
      - env:
        - name: YAOOK_BACKUP_CREATOR_BACKUP_MODULE_NAME
          value: backup_creator.services.vaultraft
        - name: YAOOK_BACKUP_CREATOR_OUT_PATH
          value: /backup/new
        - name: YAOOK_BACKUP_CREATOR_SCHEDULE
          value: 21 */12 * * *
        - name: YAOOK_BACKUP_CREATOR_VAULT_RAFT_APPROLE_SECRET_ID
          valueFrom:
            secretKeyRef:
              key: openbao_secret_id
              name: openbao-backup
        - name: YAOOK_BACKUP_CREATOR_VAULT_RAFT_APPROLE_ROLE_ID
          valueFrom:
            secretKeyRef:
              key: openbao_role_id
              name: openbao-backup
        - name: YAOOK_BACKUP_CREATOR_VAULT_RAFT_APPROLE_PATH
          valueFrom:
            secretKeyRef:
              key: openbao_approle_path
              name: openbao-backup
        - name: VAULT_ADDR
          value: "https://openbao-active.{{ openbao_on_k8s.namespace }}.svc.cluster.local:8200"
        - name: VAULT_CAPATH
          value: /openbao/ca.crt
        image: registry.yaook.cloud/yaook/backup-creator:devel
        imagePullPolicy: IfNotPresent
        name: backup-creator
        volumeMounts:
        - mountPath: /backup
          name: backup-scratch
        - mountPath: /openbao/ca.crt
          subPath: ca.crt
          name: openbao-ca
      - env:
        - name: YAOOK_BACKUP_SHIFTER_WORK_DIR
          value: /backup
        - name: YAOOK_BACKUP_SHIFTER_S3_FILE_PREFIX
          value: openbao-backup
        - name: YAOOK_BACKUP_SHIFTER_SHIFTERS
          value: dumpinfo,s3_upload
        - name: YAOOK_BACKUP_SHIFTER_S3_URL
          valueFrom:
            secretKeyRef:
              key: s3_endpoint
              name: openbao-backup
        - name: YAOOK_BACKUP_SHIFTER_S3_BUCKET
          value: {{ openbao_on_k8s.backup_s3_bucket }}
        - name: YAOOK_BACKUP_SHIFTER_S3_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              key: s3_access_key
              name: openbao-backup
        - name: YAOOK_BACKUP_SHIFTER_S3_SECRET_KEY
          valueFrom:
            secretKeyRef:
              key: s3_secret_key
              name: openbao-backup
        - name: YAOOK_BACKUP_SHIFTER_S3_CACERT
          value: /openbao/s3_ca.crt
        - name: YAOOK_BACKUP_SHIFTER_S3_ADDRESSING_STYLE
          value: {{ openbao_on_k8s.backup_s3_addressing_style }}
        - name: YAOOK_BACKUP_SHIFTER_METRICS_PORT
          value: "19100"
        image: registry.yaook.cloud/yaook/backup-shifter:1.0.166
        imagePullPolicy: IfNotPresent
        name: backup-shifter
        resources: {}
        volumeMounts:
        - mountPath: /backup
          name: backup-scratch
        - mountPath: /openbao/s3_ca.crt
          subPath: s3_ca.crt
          name: s3-ca
      volumes:
      - emptyDir: {}
        name: backup-scratch
      - name: openbao-ca
        secret:
          secretName: openbao-ca-internal
      - name: s3-ca
        secret:
          secretName: openbao-backup

---
{% if k8s_monitoring_enabled | bool %}

apiVersion: v1
kind: Service
metadata:
  labels:
    yaook.cloud/component: openbao-backup
  name: openbao-backup-monitoring
  namespace: {{ openbao_on_k8s.namespace | to_json }}
spec:
  ports:
  - port: 19100
    name: metrics
    protocol: TCP
    targetPort: 19100
  selector:
    yaook.cloud/component: openbao-backup

---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: openbao-backup
  namespace: {{ openbao_on_k8s.namespace | to_json }}
{% if monitoring_common_labels %}
  labels:
{% for label_key, label_value in monitoring_common_labels.items() %}
    {{ label_key | to_json }}: {{ label_value | to_json }}
{% endfor %}
{% endif %}
spec:
  namespaceSelector:
    matchNames:
      - {{ openbao_on_k8s.namespace }}
  selector:
    matchLabels:
      yaook.cloud/component: openbao-backup
  endpoints:
    - port: metrics
      path: /metrics
{% endif %}
