---
kind: DaemonSet
apiVersion: apps/v1
metadata:
  name: etcd-metrics-proxy
  namespace: kube-system
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: etcd-proxy-metrics
  template:
    metadata:
      labels:
        app.kubernetes.io/name: etcd-proxy-metrics
    spec:
      priorityClassName: system-node-critical
      nodeSelector:
        node-role.kubernetes.io/control-plane: ""
      tolerations:
        - operator: Exists
      hostNetwork: true
      containers:
        - name: proxy
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
          image: "alpine/socat"
          args:
# socat is not able to bind to IPv4 and IPv6 at the same time
# which is why we make use of the Linux feature that a socket
# which is bound to :: can also accept IPv4 traffic (the v4 addresses
# are mapped to ::/96). We do so by enforcing IPv6 (pf=ip6) and then
# also allow IPv4 traffic (ipv6only=0)
{% if ipv4_enabled and ipv6_enabled %}
            - openssl-listen:12381,fork,reuseaddr,cert=/certs/server.crt,key=/certs/server.key,cafile=/certs/client.crt,ipv6only=0,pf=ip6
            - TCP:[::]:2381
{% elif ipv4_enabled %}
            - openssl-listen:12381,fork,reuseaddr,cert=/certs/server.crt,key=/certs/server.key,cafile=/certs/client.crt,pf=ip4
            - TCP4:127.0.0.1:2381
{% elif ipv6_enabled %}
            - openssl-listen:12381,fork,reuseaddr,cert=/certs/server.crt,key=/certs/server.key,cafile=/certs/client.crt,pf=ip6
            - TCP:[::1]:2381
{% endif %}
          imagePullPolicy: "IfNotPresent"
          ports: []
          volumeMounts:
            - name: certs
              mountPath: /certs
              readOnly: true
      volumes:
        - name: certs
          secret:
            secretName: etcd-metrics-proxy
            items:
              - key: client.crt
                path: client.crt
              - key: server.key
                path: server.key
              - key: server.crt
                path: server.crt
---
