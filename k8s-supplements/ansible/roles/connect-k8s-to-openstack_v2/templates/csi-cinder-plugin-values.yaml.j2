storageClass:
  enabled: false
secret:
  enabled: true
  create: false
  name: cloud-config
csi:
  provisioner:
{% if openstack_cinder_enable_topology %}
    topology: "true"
{% else %}
    topology: "false"
{% endif %}
  plugin:
    nodePlugin:
      dnsPolicy: ClusterFirst
priorityClassName: system-node-critical
